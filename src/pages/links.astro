---
import { curatedLinks } from "../data/links";
import { getHostname } from "../utils/url";
import RssLink from "../components/RssLink.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const sortedLinks = curatedLinks.toSorted(
  (a, b) => new Date(b.addedAt).valueOf() - new Date(a.addedAt).valueOf(),
);
---

<SiteLayout
  title="Links"
  description="A small, curated list of external things worth sharing."
  feedHref="/links/rss.xml"
  feedTitle="Joe Petrillo — Links"
>
  <header class="page-header">
    <h1 class="page-title">Links</h1>
    <RssLink href="/links/rss.xml" label="Subscribe to the links RSS feed" />
  </header>

  <ol class="bookmarks-list">
    {
      sortedLinks.map((link) => (
        <li>
          <article class="bookmark-item">
            <time class="bookmark-item__date" datetime={link.addedAt}>
              {link.addedAt}
            </time>

            <span class="bookmark-item__title-line">
              <a
                class="bookmark-item__link"
                href={link.url}
                target="_blank"
                rel="noopener"
              >
                {link.title}
              </a>
              <span class="bookmark-item__source">{getHostname(link.url)}</span>
            </span>
          </article>
        </li>
      ))
    }
  </ol>
</SiteLayout>

<style>
  .bookmarks-list {
    display: grid;
    gap: 1.1rem;
  }

  .bookmark-item {
    display: grid;
    gap: 0.2rem;
    text-wrap: balance;
  }

  @media (min-width: 641px) {
    .bookmarks-list {
      gap: 0.7rem;
    }

    .bookmark-item {
      grid-template-columns: 5.6rem minmax(0, 1fr);
      align-items: baseline;
      gap: 0.8rem;
    }
  }

  .bookmark-item__date {
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-title);
    white-space: nowrap;
  }

  .bookmark-item__title-line {
    line-height: var(--leading-title);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .bookmark-item__link {
    color: var(--color-text);
    font-size: var(--text-body);
  }

  .bookmark-item__source {
    color: var(--color-muted);
    font-size: var(--text-meta);
    margin-left: 0.45rem;
    white-space: nowrap;
  }
</style>
