---
import { curatedLinks } from "../data/links";
import { formatMonthYear } from "../utils/date";
import { getHostname } from "../utils/url";
import SiteLayout from "../layouts/SiteLayout.astro";

const sortedLinks = curatedLinks.toSorted(
  (a, b) => new Date(b.addedAt).valueOf() - new Date(a.addedAt).valueOf()
);
---

<SiteLayout title="Links" description="A small, curated list of external things worth sharing.">
  <h1 class="page-title">Links</h1>

  <ol class="link-list">
    {
      sortedLinks.map((link) => (
        <li>
          <article>
            <h2>
              <a href={link.url} target="_blank" rel="noopener">
                {link.title}
              </a>
            </h2>
            <div class="link-meta">
              <span>{getHostname(link.url)}</span>
              <time datetime={link.addedAt}>{formatMonthYear(link.addedAt)}</time>
            </div>
            {link.note && <p>{link.note}</p>}
          </article>
        </li>
      ))
    }
  </ol>
</SiteLayout>

<style>
  .link-list {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link-list li {
    border-top: 0.0625rem solid var(--color-border);
    padding-top: 1rem;
  }

  .link-list article {
    display: grid;
    gap: 0.25rem;
  }

  .link-list h2 {
    margin-bottom: 0.25rem;
  }

  .link-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    color: var(--color-muted);
    font-size: 0.94rem;
  }
</style>
