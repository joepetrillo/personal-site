---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Page not found"
  description="This page does not exist, or it moved."
  robots="noindex, follow"
>
  <section class="section-stack" aria-labelledby="not-found-title">
    <p class="not-found-mark" aria-hidden="true">404</p>
    <h1 id="not-found-title" class="page-title">Page not found</h1>
    <p><a href="/">Go home</a></p>
  </section>
</SiteLayout>

<style>
  .not-found-mark {
    color: var(--color-text);
    font-family: var(--font-lora), Georgia, serif;
    font-size: var(--text-display);
    line-height: 1;
  }
  .page-title {
    margin-bottom: 0;
  }
</style>
