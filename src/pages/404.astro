---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Page not found"
  description="This page does not exist, or it moved."
>
  <section class="section-stack" aria-labelledby="not-found-title">
    <p class="not-found-mark" aria-hidden="true">404</p>
    <h1 id="not-found-title" class="page-title">Page not found</h1>
    <p><a href="/">Go home</a></p>
  </section>
</SiteLayout>

<style>
  .section-stack {
    display: grid;
    gap: 1.25rem;
  }

  .not-found-mark {
    color: var(--color-text);
    font-family: var(--font-comico), Georgia, serif;
    font-size: var(--text-display);
    line-height: 1;
  }
</style>
