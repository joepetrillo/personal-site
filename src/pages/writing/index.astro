---
import { getCollection } from "astro:content";
import { formatMonthYear } from "../../utils/date";
import RssLink from "../../components/RssLink.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const writingEntries = await getCollection(
  "writing",
  (entry) => !entry.data.draft,
);
const entries = writingEntries.toSorted(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout
  title="Writing"
  description="Writing by Joe Petrillo about software, projects, travel, learning, and things worth sharing."
  feedHref="/writing/rss.xml"
  feedTitle="Joe Petrillo — Writing"
>
  <header class="page-header">
    <h1 class="page-title">Writing</h1>
    <RssLink href="/writing/rss.xml" label="Subscribe to the writing RSS feed" />
  </header>

  {
    entries.length > 0 ? (
      <ol class="dated-list">
        {entries.map((entry) => (
          <li>
            <article class="dated-entry">
              <time
                class="dated-entry__date"
                datetime={entry.data.pubDate.toISOString()}
              >
                {formatMonthYear(entry.data.pubDate)}
              </time>
              <a class="dated-entry__title" href={`/writing/${entry.id}`}>
                {entry.data.title}
              </a>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-state">Nothing here yet.</p>
    )
  }
</SiteLayout>
