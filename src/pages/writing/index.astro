---
import { getCollection } from "astro:content";
import { formatMonthYear } from "../../utils/date";
import DatedEntry from "../../components/DatedEntry.astro";
import DatedList from "../../components/DatedList.astro";
import EmptyState from "../../components/EmptyState.astro";
import PageHeader from "../../components/PageHeader.astro";
import RssLink from "../../components/RssLink.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const writingEntries = await getCollection(
  "writing",
  (entry) => !entry.data.draft,
);
const entries = writingEntries.toSorted(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout
  title="Writing"
  description="Writing by Joe Petrillo about software, projects, travel, learning, and things worth sharing."
  feedHref="/writing/rss.xml"
  feedTitle="Joe Petrillo — Writing"
>
  <PageHeader title="Writing">
    <RssLink href="/writing/rss.xml" label="Subscribe to the writing RSS feed" />
  </PageHeader>

  {
    entries.length > 0 ? (
      <DatedList>
        {entries.map((entry) => (
          <DatedEntry
            dateLabel={formatMonthYear(entry.data.pubDate)}
            dateTime={entry.data.pubDate.toISOString()}
            href={`/writing/${entry.id}`}
            title={entry.data.title}
          />
        ))}
      </DatedList>
    ) : (
      <EmptyState>Nothing here yet.</EmptyState>
    )
  }
</SiteLayout>
