---
import { curatedLinks } from "../../data/links";
import { getHostname } from "../../utils/url";
import DatedEntry from "../../components/DatedEntry.astro";
import DatedList from "../../components/DatedList.astro";
import PageHeader from "../../components/PageHeader.astro";
import RssLink from "../../components/RssLink.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const sortedLinks = curatedLinks.toSorted(
  (a, b) => new Date(b.addedAt).valueOf() - new Date(a.addedAt).valueOf(),
);
---

<SiteLayout
  title="Links"
  description="A small, curated list of external things worth sharing."
  feedHref="/links/rss.xml"
  feedTitle="Joe Petrillo — Links"
>
  <PageHeader title="Links">
    <RssLink href="/links/rss.xml" label="Subscribe to the links RSS feed" />
  </PageHeader>

  <DatedList>
    {
      sortedLinks.map((link) => (
        <DatedEntry
          dateLabel={link.addedAt}
          dateTime={link.addedAt}
          href={link.url}
          title={link.title}
          external
        >
          <span slot="titleMeta" class="bookmark-source">
            {getHostname(link.url)}
          </span>
        </DatedEntry>
      ))
    }
  </DatedList>
</SiteLayout>

<style>
  .bookmark-source {
    color: var(--color-muted);
    font-size: var(--text-meta);
    white-space: nowrap;
  }
</style>
