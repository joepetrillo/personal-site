---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
import { SITE } from "../data/site";
import { timelineEntries } from "../data/home";
import TextLinkList from "../components/TextLinkList.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const personalLinks = [
  { href: SITE.githubUrl, label: "GitHub", external: true },
  { href: SITE.linkedInUrl, label: "LinkedIn", external: true },
  { href: SITE.resumeUrl, label: "Resume", external: true },
  { href: SITE.emailHref, label: "Email" },
];
---

<SiteLayout>
  <div class="page-stack">
    <section class="personal-overview" aria-labelledby="home-title">
      <h1 id="home-title" class="sr-only">{SITE.name}</h1>

      <div class="personal-overview__layout">
        <div class="personal-overview__column">
          <p class="intro-copy__paragraph intro-copy__paragraph--lead">
            Software engineer from Boston, MA.
          </p>

          <div class="personal-overview__body">
            <p class="intro-copy__paragraph">
              Most of my focus is on web technologies, with AI agents becoming a
              bigger part of how I work. I write about what I'm learning and
              what I'm building, with the occasional detour into travel,
              everyday life, or whatever else has my attention.
            </p>

            <aside class="intro-current" aria-label="Current role">
              <p class="intro-current__text">
                Now at <a
                  href="https://www.linkedin.com/company/citizens-bank"
                  target="_blank"
                  rel="noopener">Citizens Bank</a
                >, working on microfrontends.
              </p>
            </aside>

            <nav aria-label="Personal links">
              <TextLinkList items={personalLinks} />
            </nav>
          </div>
        </div>

        <Image
          class="personal-overview__avatar"
          src={avatar}
          layout="fixed"
          width={200}
          height={200}
          alt={SITE.name}
          priority
        />
      </div>
    </section>

    <section class="section-stack" aria-labelledby="timeline-title">
      <h2 id="timeline-title" class="home-section-title">Timeline</h2>
      <ol class="timeline">
        {
          timelineEntries.map((entry) => (
            <li class="timeline__item">
              <time class="timeline__year" datetime={entry.year}>
                {entry.year}
              </time>
              <article class="timeline__body">
                <h3 class="timeline__title">{entry.title}</h3>
                <p class="timeline__description">{entry.description}</p>
              </article>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</SiteLayout>

<style>
  .page-stack {
    display: grid;
    gap: var(--space-section);
  }

  .section-stack {
    display: grid;
    gap: 1.5rem;
  }

  .home-section-title {
    font-family: var(--font-serif);
    font-size: var(--text-medium);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
  }

  .personal-overview__layout {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    row-gap: 1.25rem;
  }

  .personal-overview__column {
    display: contents;
  }

  .personal-overview__body {
    display: grid;
    gap: 1.25rem;
    grid-column: 1 / -1;
    grid-row: 2;
    max-width: 39rem;
  }

  .personal-overview__avatar {
    align-self: center;
    grid-column: 1;
    grid-row: 1;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--color-surface);
    object-fit: cover;
  }

  .intro-copy__paragraph {
    color: var(--color-text);
    font-size: var(--text-medium);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  .intro-copy__paragraph--lead {
    grid-column: 2;
    grid-row: 1;
    max-width: 13.25rem;
    min-width: 0;
    font-family: var(--font-serif);
    font-size: var(--text-large);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    text-wrap: wrap;
  }

  .intro-current {
    max-width: 39rem;
    border-inline-start: var(--line-width-strong) solid var(--color-border);
    padding-inline-start: 0.875rem;
  }

  .intro-current__text {
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--leading-ui);
    text-wrap: pretty;
  }

  .intro-current a {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration-line: underline;
  }

  .timeline {
    display: grid;
    gap: 1rem;
  }

  .timeline__item {
    display: grid;
    gap: 1rem;
    border-top: var(--line-width) solid var(--color-border);
    padding-top: 1rem;
  }

  .timeline__year {
    color: var(--color-muted);
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-ui);
  }

  .timeline__body {
    display: grid;
    gap: 0.4rem;
  }

  .timeline__title {
    line-height: var(--leading-heading);
  }

  .timeline__description {
    color: var(--color-muted);
    line-height: var(--leading-body);
  }

  @media (min-width: 641px) {
    .personal-overview__layout {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1.75rem;
      align-items: start;
    }

    .personal-overview__column {
      display: grid;
      gap: 1rem;
      grid-column: 1;
      grid-row: 1;
    }

    .intro-copy__paragraph--lead {
      grid-column: auto;
      grid-row: auto;
      max-width: none;
      text-wrap: balance;
    }

    .personal-overview__body {
      grid-column: auto;
      grid-row: auto;
    }

    .personal-overview__avatar {
      align-self: start;
      grid-column: 2;
      grid-row: 1;
      width: 8rem;
      height: 8rem;
    }

    .timeline__item {
      grid-template-columns: 4.5rem 1fr;
    }
  }
</style>
