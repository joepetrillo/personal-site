---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
import { SITE } from "../data/site";
import { timelineEntries } from "../data/home";
import TextLinkList from "../components/TextLinkList.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const personalLinks = [
  { href: SITE.githubUrl, label: "GitHub", external: true },
  { href: SITE.linkedInUrl, label: "LinkedIn", external: true },
  { href: SITE.resumeUrl, label: "Resume", external: true },
  { href: SITE.emailHref, label: "Email" },
];
---

<SiteLayout description={SITE.shortDescription}>
  <div class="page-stack">
    <section class="personal-overview" aria-labelledby="home-title">
      <div class="personal-overview__content">
        <h1 id="home-title" class="sr-only">Joe Petrillo</h1>

        <div class="intro-copy">
          <p class="intro-copy__paragraph intro-copy__paragraph--lead">
            Welcome! I’m Joe, a software engineer who cares about writing good
            code and building things that are reliable, easy to use, and hard to
            break.
          </p>
          <p class="intro-copy__paragraph">
            I use this site to write about software, projects, travel, things
            I’m learning, and whatever else I find worth sharing. I also like to
            keep track of things like books and movies that I've most enjoyed.
          </p>
          <p class="intro-copy__paragraph">
            I'm currently working at <a
              href="https://www.linkedin.com/company/citizens-bank"
              target="_blank"
              rel="noopener">Citizens Bank</a
            >.
          </p>
        </div>

        <nav aria-label="Personal links">
          <TextLinkList items={personalLinks} />
        </nav>
      </div>

      <Image
        class="personal-overview__avatar"
        src={avatar}
        layout="fixed"
        width={200}
        height={200}
        alt="Joe Petrillo"
        priority
      />
    </section>

    <section class="section-stack" aria-labelledby="timeline-title">
      <h2 id="timeline-title" class="home-section-title">Timeline</h2>
      <ol class="timeline">
        {
          timelineEntries.map((entry) => (
            <li class="timeline__item">
              <time class="timeline__year" datetime={entry.year}>
                {entry.year}
              </time>
              <article class="timeline__body">
                <h3 class="timeline__title">{entry.title}</h3>
                <p class="timeline__description">{entry.description}</p>
              </article>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</SiteLayout>

<style>
  .page-stack {
    display: grid;
    gap: var(--space-section);
  }

  .section-stack {
    display: grid;
    gap: 1.5rem;
  }

  .home-section-title {
    font-family: var(--font-serif);
    font-size: var(--text-medium);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
  }

  .personal-overview {
    display: grid;
    align-items: start;
    gap: 1.75rem;
  }

  .personal-overview__content {
    display: grid;
    grid-row: 2;
    gap: 1.25rem;
  }

  .personal-overview__avatar {
    grid-row: 1;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: var(--color-surface);
    object-fit: cover;
  }

  .intro-copy {
    display: grid;
    max-width: 39rem;
    gap: 1rem;
  }

  .intro-copy__paragraph {
    color: var(--color-text);
    font-size: var(--text-medium);
    line-height: var(--leading-body);
  }

  .intro-copy__paragraph--lead {
    font-family: var(--font-serif);
    font-size: var(--text-large);
    font-weight: var(--weight-medium);
    line-height: var(--leading-ui);
  }

  .intro-copy a {
    font-weight: var(--weight-medium);
    text-decoration-line: underline;
  }

  .timeline {
    display: grid;
    gap: 1rem;
  }

  .timeline__item {
    display: grid;
    gap: 1rem;
    border-top: var(--line-width) solid var(--color-border);
    padding-top: 1rem;
  }

  .timeline__year {
    color: var(--color-muted);
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-ui);
  }

  .timeline__body {
    display: grid;
    gap: 0.4rem;
  }

  .timeline__title {
    line-height: var(--leading-heading);
  }

  .timeline__description {
    color: var(--color-muted);
    line-height: var(--leading-body);
  }

  @media (min-width: 641px) {
    .personal-overview {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .personal-overview__content {
      grid-row: auto;
    }

    .personal-overview__avatar {
      grid-row: auto;
    }

    .timeline__item {
      grid-template-columns: 4.5rem 1fr;
    }
  }
</style>
