---
import { projects } from "../data/projects";
import SiteLayout from "../layouts/SiteLayout.astro";

const sortedProjects = projects.toSorted((a, b) => b.year - a.year);
---

<SiteLayout
  title="Projects"
  description="Public things Joe Petrillo personally built or materially shaped."
>
  <header class="page-header">
    <h1 class="page-title">Projects</h1>
  </header>

  <ol class="dated-list dated-list">
    {
      sortedProjects.map((project) => (
        <li>
          <article class="dated-entry">
            <time class="dated-entry__date" datetime={String(project.year)}>
              {project.year}
            </time>

            <div class="project-body">
              <a
                class="dated-entry__title"
                href={project.url}
                target="_blank"
                rel="noopener"
              >
                {project.title}
              </a>
              <p class="project-note">{project.note}</p>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</SiteLayout>

<style>
  .project-body {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
  }

  .project-note {
    line-height: var(--leading-title);
    text-wrap: pretty;
    color: var(--color-muted);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    color: var(--color-muted);
    font-size: var(--text-meta);
  }
</style>
