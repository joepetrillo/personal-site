---
import { projects } from "../data/projects";
import SiteLayout from "../layouts/SiteLayout.astro";

const sortedProjects = projects.toSorted((a, b) => b.year - a.year);
---

<SiteLayout
  title="Projects"
  description="Public things Joe Petrillo personally built or materially shaped."
>
  <header class="page-header">
    <h1 class="page-title">Projects</h1>
  </header>

  <ol class="entry-list">
    {
      sortedProjects.map((project) => (
        <li>
          <article class="entry-list__item">
            <h2 class="entry-list__title">
              <a href={project.githubUrl} target="_blank" rel="noopener">
                {project.title}
              </a>
            </h2>
            <p>{project.note}</p>
            <footer class="entry-meta">
              <time datetime={String(project.year)}>{project.year}</time>
              <a href={project.githubUrl} target="_blank" rel="noopener">
                GitHub
              </a>
              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener">
                  Live
                </a>
              )}
            </footer>
          </article>
        </li>
      ))
    }
  </ol>
</SiteLayout>

<style>
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }
</style>
