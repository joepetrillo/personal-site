---
import { projects } from "../data/projects";
import DatedEntry from "../components/DatedEntry.astro";
import DatedList from "../components/DatedList.astro";
import PageHeader from "../components/PageHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const sortedProjects = projects.toSorted((a, b) => b.year - a.year);
---

<SiteLayout
  title="Projects"
  description="Public things Joe Petrillo personally built or materially shaped."
>
  <PageHeader title="Projects" />

  <DatedList>
    {
      sortedProjects.map((project) => (
        <DatedEntry
          dateLabel={project.year}
          dateTime={String(project.year)}
          href={project.url}
          title={project.title}
          external
        >
          <p class="project-note">{project.note}</p>
        </DatedEntry>
      ))
    }
  </DatedList>
</SiteLayout>

<style>
  .project-note {
    line-height: var(--leading-body);
    text-wrap: pretty;
    color: var(--color-muted);
  }
</style>
