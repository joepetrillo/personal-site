---
import { projects } from "../data/projects";
import SiteLayout from "../layouts/SiteLayout.astro";

const sortedProjects = projects.toSorted((a, b) => b.year - a.year);
---

<SiteLayout
  title="Projects"
  description="Public things Joe Petrillo personally built or materially shaped."
>
  <h1 class="page-title">Projects</h1>

  <ol class="project-list">
    {
      sortedProjects.map((project) => (
        <li>
          <article>
            <h2>
              <a href={project.githubUrl} target="_blank" rel="noopener">
                {project.title}
              </a>
            </h2>
            <p>{project.note}</p>
            <div class="project-meta">
              <span>{project.year}</span>
              <a href={project.githubUrl} target="_blank" rel="noopener">
                GitHub
              </a>
              {
                project.liveUrl && (
                  <a href={project.liveUrl} target="_blank" rel="noopener">
                    Live
                  </a>
                )
              }
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</SiteLayout>

<style>
  .project-list {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list li {
    border-top: 0.0625rem solid var(--color-border);
    padding-top: 1rem;
  }

  .project-list article {
    display: grid;
    gap: 0.25rem;
  }

  .project-list h2 {
    margin-bottom: 0.25rem;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    color: var(--color-muted);
    font-size: 0.94rem;
  }
</style>
