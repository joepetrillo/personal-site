---
import type { FavoriteQuote } from "../data/favorites/types";
import EmptyState from "./EmptyState.astro";
import FavoriteCategoryHeader from "./FavoriteCategoryHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
  description: string;
  emptyMessage: string;
  items: FavoriteQuote[];
  title: string;
}

const { description, emptyMessage, items, title } = Astro.props;
---

<SiteLayout title={title} description={description}>
  <FavoriteCategoryHeader />

  {
    items.length > 0 ? (
      <ol class="quotes-list" aria-label="Favorite quotes">
        {items.map((item) => (
          <li>
            <figure class="quote-item">
              <blockquote class="quote-item__body">
                <p class="quote-item__text">“{item.quote}”</p>
              </blockquote>
              <figcaption class="quote-item__caption">{item.person}</figcaption>
            </figure>
          </li>
        ))}
      </ol>
    ) : (
      <EmptyState>{emptyMessage}</EmptyState>
    )
  }
</SiteLayout>

<style>
  .quotes-list {
    display: grid;
    gap: var(--space-list);
  }

  .quote-item {
    display: grid;
    gap: 0.45rem;
  }

  .quote-item__body {
    border-inline-start: var(--blockquote-rule-width) solid var(--color-border);
    padding-inline-start: var(--blockquote-padding-inline);
    font-size: var(--text-medium);
  }

  .quote-item__text {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: inherit;
    font-weight: var(--weight-medium);
    line-height: var(--leading-quote);
  }

  .quote-item__caption {
    color: var(--color-muted);
    font-size: var(--text-meta);
  }
</style>
