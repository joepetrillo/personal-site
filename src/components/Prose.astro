---
interface Props {
  copyHeadingLinks?: boolean;
}

const { copyHeadingLinks = false } = Astro.props;

// Shared long-form typography. Wraps slotted content (MDX from the writing
// collection, or any rich text) in a `.prose` column and styles its children
// via `:global()`, since that content lives outside this component's scope.
//
// Spacing, scale, and element treatments borrow the plain-language rhythm of
// tailwindcss-typography's larger prose tiers, then tune it for this narrow,
// static personal site: relaxed paragraphs, clear section breaks, and headings
// that stay visually attached to the content they introduce.
---

<div
  class:list={["prose", copyHeadingLinks && "prose--copy-heading-links"]}
  data-copy-heading-links={copyHeadingLinks ? "true" : undefined}
>
  <slot />
</div>

{
  copyHeadingLinks && (
    <>
      <span
        aria-atomic="true"
        aria-live="polite"
        class="sr-only"
        data-copy-heading-link-status
      />
      <script is:inline>
        (() => {
          const headingSelector = "h2[id], h3[id], h4[id], h5[id], h6[id]";
          const status = document.querySelector(
            "[data-copy-heading-link-status]"
          );
          const pageUrlBase = `${window.location.origin}${window.location.pathname}`;
          const idleState = "idle";
          const svgNamespace = "http://www.w3.org/2000/svg";
          const iconPaths = {
            check: ["M20 6 9 17l-5-5"],
            link: [
              "M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71",
              "M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71",
            ],
          };
          const resetTimers = new WeakMap();

          const getCopyUrl = (heading) => `${pageUrlBase}#${heading.id}`;

          const announce = (message) => {
            if (!status) {
              return;
            }

            status.textContent = message;
          };

          const setButtonIcon = (button, icon) => {
            const svg = button.querySelector("svg");

            if (!svg) {
              return;
            }

            const paths = iconPaths[icon].map((pathData) => {
              const path = document.createElementNS(svgNamespace, "path");
              path.setAttribute("d", pathData);
              return path;
            });

            svg.replaceChildren(...paths);
          };

          const resetButton = (button) => {
            button.dataset.state = idleState;
            setButtonIcon(button, "link");
          };

          const handleCopy = async (button, heading) => {
            const headingText = heading.textContent?.trim() ?? "section";

            try {
              await navigator.clipboard.writeText(getCopyUrl(heading));
              button.dataset.state = "copied";
              setButtonIcon(button, "check");
              announce(`Copied link to section: ${headingText}`);

              const previousTimer = resetTimers.get(button);

              if (previousTimer) {
                window.clearTimeout(previousTimer);
              }

              resetTimers.set(
                button,
                window.setTimeout(() => resetButton(button), 1600)
              );
            } catch {
              button.dataset.state = "failed";
              announce(`Could not copy link to section: ${headingText}`);
            }
          };

          const handleClick = (event) => {
            const { target } = event;

            if (!(target instanceof Element)) {
              return;
            }

            const button = target.closest(".copy-heading-link");

            if (!(button instanceof HTMLButtonElement)) {
              return;
            }

            const heading = button.closest(headingSelector);

            if (!heading) {
              return;
            }

            void handleCopy(button, heading);
          };

          for (const prose of document.querySelectorAll(
            ".prose[data-copy-heading-links]"
          )) {
            prose.addEventListener("click", handleClick);
          }
        })();
      </script>
    </>
  )
}

<style>
  .prose {
    font-size: var(--text-medium);
    line-height: var(--leading-body);
    color: var(--color-text);
    /* Long, unbroken content — bare URLs, hashes, a single-word heading — must
       break to stay inside the column. `anywhere` rather than `break-word` so
       an over-long token starts breaking on the *current* line and fills it,
       instead of being bumped whole to the next line first. Inherited by every
       text descendant; table cells tune this back to normal wrapping below. */
    overflow-wrap: anywhere;
  }

  /* The column's edges are owned by the page layout, not the content. */
  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose > :global(:last-child) {
    margin-bottom: 0;
  }

  /* ----- Paragraphs ----- */
  .prose :global(p) {
    margin-block: 1.3333em;
  }

  /* ----- Links ----- */
  /* Running-text links are underlined at rest and weighted slightly higher so
     they remain clear inside dense prose. */
  .prose :global(a) {
    font-weight: var(--weight-medium);
  }

  .prose
    :global(
      :is(p, li, blockquote, td, th, caption, figcaption, dt, dd, summary) a
    ) {
    text-decoration-line: underline;
  }

  /* ----- Headings ----- */
  /* h1 is reserved for the page title outside the prose column, so content
     starts at h2. Sizes are em-based off the prose body like the `lg` tier:
     h2 ≈ 30px, h3 ≈ 24px, h4–h6 body-sized. Family and color come from the
     global heading rules (serif, text color). */
  .prose :global(h2) {
    font-size: 1.5em;
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    margin-top: 2em;
    margin-bottom: 0.65em;
  }

  .prose :global(h3) {
    font-size: 1.25em;
    font-weight: var(--weight-bold);
    line-height: 1.28;
    margin-top: 1.75em;
    margin-bottom: 0.5em;
  }

  .prose :global(h4),
  .prose :global(h5),
  .prose :global(h6) {
    font-weight: var(--weight-bold);
    line-height: 1.38;
    margin-top: 1.7778em;
    margin-bottom: 0.4444em;
  }

  /* The heading's own bottom margin provides the lead-out; don't stack the
     next block's top margin on top of it. */
  .prose :global(:is(h2, h3, h4, h5, h6) + *) {
    margin-top: 0;
  }

  /* Anchor links rendered for headings inherit heading color and weight. */
  .prose :global(:is(h2, h3, h4, h5, h6) a) {
    color: inherit;
    font-weight: inherit;
  }

  .prose:not(.prose--copy-heading-links)
    :global(.copy-heading-link__text) {
    display: contents;
  }

  .prose:not(.prose--copy-heading-links) :global(.copy-heading-link) {
    display: none;
  }

  .prose--copy-heading-links :global(:is(h2, h3, h4, h5, h6)[id]) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .prose--copy-heading-links :global(.copy-heading-link__text) {
    min-width: 0;
  }

  .prose--copy-heading-links :global(.copy-heading-link) {
    display: inline-flex;
    flex: 0 0 2.5rem;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0;
  }

  .prose--copy-heading-links :global(.copy-heading-link:hover),
  .prose--copy-heading-links :global(.copy-heading-link:focus-visible),
  .prose--copy-heading-links :global(.copy-heading-link[data-state="copied"]) {
    color: var(--color-text);
  }

  .prose--copy-heading-links :global(.copy-heading-link svg) {
    width: 1rem;
    height: 1rem;
    pointer-events: none;
    stroke-width: 2;
  }

  @media (max-width: 52rem), (hover: none), (pointer: coarse) {
    .prose--copy-heading-links :global(.copy-heading-link) {
      color: var(--color-muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prose--copy-heading-links :global(.copy-heading-link) {
      transition-duration: 0s;
    }
  }

  /* ----- Lists ----- */
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 1.3333em;
    padding-inline-start: 1.5556em;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(ol[type="A"]) {
    list-style: upper-alpha;
  }

  .prose :global(ol[type="a"]) {
    list-style: lower-alpha;
  }

  .prose :global(ol[type="I"]) {
    list-style: upper-roman;
  }

  .prose :global(ol[type="i"]) {
    list-style: lower-roman;
  }

  /* Ordered lists: the start padding has to fit the widest marker, which CSS
     can't measure directly — so step it up per digit count using `:has()` on
     the item index. Lists with a `start` offset can't be counted this way;
     assume three digits for those. (em units so the room scales with type.) */
  .prose :global(ol:has(> li:nth-child(10))) {
    padding-inline-start: 2.2em;
  }

  .prose :global(ol:has(> li:nth-child(100))),
  .prose :global(ol[start]) {
    padding-inline-start: 2.9em;
  }

  .prose :global(ol:has(> li:nth-child(1000))) {
    padding-inline-start: 3.6em;
  }

  .prose :global(li) {
    margin-block: 0.6667em;
  }

  .prose :global(:is(ul, ol) > li) {
    padding-inline-start: 0.4444em;
  }

  .prose :global(ul > li::marker) {
    color: var(--color-muted);
  }

  .prose :global(ol > li::marker) {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Loose lists: paragraphs inside items keep a smaller rhythm, but the list's
     first/last paragraphs match the surrounding flow. */
  .prose > :global(:is(ul, ol) > li p) {
    margin-block: 0.8889em;
  }

  .prose > :global(:is(ul, ol) > li > p:first-child) {
    margin-top: 1.3333em;
  }

  .prose > :global(:is(ul, ol) > li > p:last-child) {
    margin-bottom: 1.3333em;
  }

  /* Nested lists tuck in with a tighter rhythm. */
  .prose :global(:is(ul, ol) :is(ul, ol)) {
    margin-block: 0.8889em;
  }

  /* GitHub-style task lists: drop the bullet, pull the item back across the
     list's start padding (and its own item padding) so the checkbox sits
     flush with the prose edge. */
  .prose :global(li:has(> input[type="checkbox"])) {
    list-style: none;
    margin-inline-start: -2em;
  }

  .prose :global(li > input[type="checkbox"]) {
    margin-inline-end: 0.5rem;
    accent-color: var(--color-accent);
  }

  /* ----- Definition lists ----- */
  .prose :global(dl) {
    margin-block: 1.3333em;
  }

  .prose :global(dt) {
    margin-top: 1.3333em;
    font-weight: var(--weight-bold);
  }

  .prose :global(dd) {
    margin-top: 0.6667em;
    padding-inline-start: 1.5556em;
  }

  /* ----- Inline emphasis & small mechanics ----- */
  .prose :global(strong) {
    font-weight: var(--weight-bold);
  }

  .prose :global(abbr) {
    text-underline-offset: 0.2rem;
  }

  .prose :global(mark) {
    border-radius: 0.2em;
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    color: var(--color-text);
    padding: 0.05em 0.25em;
  }

  .prose :global(code) {
    border: var(--line-width) solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.08em 0.3em;
  }

  .prose :global(:not(pre) > code) {
    overflow-wrap: break-word;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* Keys read as keycaps: body face (not mono, so they don't read as code),
     with a hairline ring and a dropped bottom edge drawn as shadows. */
  .prose :global(kbd) {
    font-family: inherit;
    font-size: 0.8889em;
    font-weight: var(--weight-medium);
    color: var(--color-text);
    border-radius: 0.3125rem;
    padding: 0.1em 0.5em;
    box-shadow:
      0 0 0 var(--line-width) var(--color-border),
      0 3px 0 var(--color-border);
    white-space: nowrap;
  }

  /* ----- Blockquote ----- */
  .prose :global(blockquote) {
    margin-block: 1.6667em;
    padding-inline-start: var(--blockquote-padding-inline);
    border-inline-start: var(--blockquote-rule-width) solid var(--color-border);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--weight-medium);
    line-height: var(--leading-quote);
  }

  .prose :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  /* ----- Horizontal rule as a quiet section break ----- */
  .prose :global(hr) {
    border: 0;
    border-top: var(--line-width) solid var(--color-border);
    margin-block: 3.1111em;
  }

  .prose :global(hr + *) {
    margin-top: 0;
  }

  /* ----- Figures & media ----- */
  .prose :global(img),
  .prose :global(picture),
  .prose :global(video) {
    margin-block: 1.7778em;
  }

  .prose :global(img) {
    border: var(--line-width) solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
  }

  .prose :global(figure) {
    margin-block: 1.7778em;
  }

  .prose :global(figure > *) {
    margin-block: 0;
  }

  .prose :global(figcaption) {
    color: var(--color-muted);
    font-size: 0.8889em;
    line-height: 1.5;
    margin-top: 1em;
    text-wrap: pretty;
  }

  /* ----- Tables ----- */
  /* Markdown tables are wrapped during rendering so the wrapper can scroll
     while the table itself stays a normal full-width table. */
  .prose :global(.prose-table-scroll) {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border: var(--line-width) solid var(--color-border);
    /* The scroll clip (`overflow-x: auto`) keeps row backgrounds inside
       rounded corners. */
    border-radius: var(--radius-small);
    background: var(--color-background);
    margin-block: 2em;
    font-size: 0.8889em;
    line-height: 1.5;
  }

  .prose :global(.prose-table-scroll > table) {
    width: 100%;
    min-width: 100%;
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    min-width: 8ch;
    overflow-wrap: normal;
    text-align: start;
  }

  .prose :global(thead) {
    border-bottom: var(--line-width) solid var(--color-border);
  }

  .prose :global(thead th) {
    font-weight: var(--weight-bold);
    vertical-align: bottom;
    padding: 0.75em;
    white-space: nowrap;
  }

  .prose :global(tbody td) {
    vertical-align: baseline;
    padding: 0.75em;
  }

  /* Zebra striping carries the row rhythm — no per-row borders needed. */
  .prose :global(tbody tr:nth-child(even)) {
    background: var(--color-surface);
  }

  /* ----- Code blocks ----- */
  .prose :global(pre) {
    overflow-x: auto;
    border: var(--line-width) solid var(--color-border);
    margin-block: 2em;
    background-image: linear-gradient(transparent, transparent);
    padding: 1em 1.5em;
    border-radius: var(--radius-small);
    font-size: 0.8889em;
    line-height: var(--leading-ui);
    tab-size: 2;
  }

  .prose :global(pre > code) {
    border: 0;
    padding: 0;
    background: transparent;
  }
</style>
