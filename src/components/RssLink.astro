---
interface Props {
  href: string;
  label?: string;
}

const { href, label = "RSS feed" } = Astro.props;
---

<a class="rss-link" href={href} aria-label={label}>
  <svg
    class="rss-link__icon"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44z"
    ></path>
    <path d="M4 10.1A9.9 9.9 0 0 1 13.9 20h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"
    ></path>
    <circle cx="6.18" cy="17.82" r="2.18"></circle>
  </svg>
</a>

<style>
  .rss-link {
    display: inline-flex;
    flex: 0 0 2.5rem;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0;
    text-decoration: none;
  }

  .rss-link:hover,
  .rss-link:focus-visible {
    color: var(--color-text);
    text-decoration: none;
  }

  .rss-link__icon {
    width: 1.25rem;
    height: 1.25rem;
    pointer-events: none;
  }

  @media (max-width: 52rem), (hover: none), (pointer: coarse) {
    .rss-link {
      color: var(--color-muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rss-link {
      transition-duration: 0s;
    }
  }
</style>
