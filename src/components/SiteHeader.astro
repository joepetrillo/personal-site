---
import TextLinkList from "./TextLinkList.astro";
import { SITE } from "../data/site";

interface NavigationItem {
  activePaths?: string[];
  href: string;
  label: string;
}

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigationItems = [
  { href: "/writing", label: "Writing" },
  { href: "/links", label: "Links" },
  { href: "/projects", label: "Projects" },
  {
    activePaths: ["/movies", "/books", "/quotes"],
    href: "/movies",
    label: "Favorites",
  },
] satisfies NavigationItem[];

const matchesPath = (href: string): boolean =>
  currentPath === href || currentPath.startsWith(`${href}/`);

const isActivePath = (item: NavigationItem): boolean =>
  item.activePaths?.some(matchesPath) ?? matchesPath(item.href);
const navigationLinks = navigationItems.map((item) => ({
  active: isActivePath(item),
  href: item.href,
  label: item.label,
}));
---

<header class="site-header">
  <nav class="site-nav site-shell" aria-label="Primary navigation">
    <a
      class="site-nav__home"
      href="/"
      aria-current={currentPath === "/" ? "page" : undefined}
    >
      {SITE.navName}
    </a>

    <TextLinkList items={navigationLinks} />
  </nav>
</header>

<style>
  .site-header {
    padding-block: 1.5rem 3rem;
  }

  .site-nav {
    display: grid;
    gap: 0.75rem;
  }

  .site-nav__home {
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
    font-weight: var(--weight-bold);
    line-height: var(--leading-ui);
    justify-self: start;
  }

  .site-nav__home[aria-current="page"] {
    text-decoration-color: var(--link-underline-active-color);
    text-decoration-line: underline;
  }

  @media (min-width: 500px) {
    .site-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }
</style>
