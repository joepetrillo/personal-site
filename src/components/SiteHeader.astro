---
import { SITE } from "../data/site";

interface NavigationItem {
  href: string;
  label: string;
}

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigationItems = [
  { href: "/writing", label: "Writing" },
  { href: "/projects", label: "Projects" },
  { href: "/links", label: "Links" },
] satisfies NavigationItem[];

const isActivePath = (href: string): boolean =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="site-nav__home" href="/" aria-current={currentPath === "/" ? "page" : undefined}>
      {SITE.navName}
    </a>
    <div class="site-nav__links">
      {
        navigationItems.map((item) => (
          <a href={item.href} aria-current={isActivePath(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    padding-block: 1.25rem 2.5rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(var(--layout-width), calc(100% - (var(--space-page) * 2)));
    margin-inline: auto;
    gap: 1.5rem;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    color: var(--color-muted);
    font-size: 0.94rem;
    text-decoration-color: var(--link-underline-active-color);
    text-decoration-line: none;
    text-decoration-thickness: var(--link-underline-thickness);
    text-underline-offset: var(--link-underline-offset);
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    text-decoration-color: var(--link-underline-active-color);
    text-decoration-line: underline;
  }

  .site-nav a[aria-current="page"] {
    color: var(--color-text);
  }

  .site-nav__home {
    color: var(--color-text);
    font-weight: 650;
    justify-self: start;
  }

  .site-nav__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .site-nav {
      display: grid;
      align-items: flex-start;
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .site-nav__links {
      justify-content: flex-start;
    }
  }
</style>
