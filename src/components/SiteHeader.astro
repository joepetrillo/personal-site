---
import { SITE } from "../data/site";

interface NavigationItem {
  activePaths?: string[];
  href: string;
  label: string;
}

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigationItems = [
  { href: "/writing", label: "Writing" },
  { href: "/projects", label: "Projects" },
  { href: "/links", label: "Links" },
  {
    activePaths: ["/books", "/movies", "/music", "/quotes"],
    href: "/books",
    label: "Favorites",
  },
] satisfies NavigationItem[];

const matchesPath = (href: string): boolean =>
  currentPath === href || currentPath.startsWith(`${href}/`);

const isActivePath = (item: NavigationItem): boolean =>
  item.activePaths?.some(matchesPath) ?? matchesPath(item.href);
---

<header class="site-header">
  <nav class="site-nav site-shell" aria-label="Primary navigation">
    <a
      class="site-nav__link site-nav__home nav-link"
      href="/"
      aria-current={currentPath === "/" ? "page" : undefined}
    >
      {SITE.navName}
    </a>

    <ul class="site-nav__links">
      {
        navigationItems.map((item) => (
          <li>
            <a
              class="site-nav__link nav-link"
              href={item.href}
              aria-current={isActivePath(item) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    padding-block: 1.25rem 2.5rem;
  }

  .site-nav {
    display: grid;
    grid-template-columns: 1fr;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .site-nav__home {
    color: var(--color-text);
    font-weight: var(--weight-bold);
    justify-self: start;
  }

  .site-nav__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 500px) {
    .site-nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .site-nav__links {
      justify-content: flex-end;
    }
  }
</style>
