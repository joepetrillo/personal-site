---
import type { FavoriteImage } from "../data/favorites/types";
import { Image } from "astro:assets";

interface Props {
  aspectRatio: string;
  image?: FavoriteImage;
  size?: "card" | "track";
  title: string;
}

const { aspectRatio, image, size = "card", title } = Astro.props;

const coverWidth = size === "track" ? 128 : 300;
const coverHeight = size === "track" ? 128 : 450;

const placeholderText = title
  .split(/\s+/u)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word.at(0)?.toUpperCase() ?? "")
  .join("");
---

<span
  class:list={[
    "favorite-cover",
    `favorite-cover--${size}`,
    !image && "favorite-cover--placeholder",
  ]}
  style={`--cover-aspect-ratio: ${image?.aspectRatio ?? aspectRatio}`}
>
  {
    image ? (
      <Image
        class="favorite-cover__image"
        src={image.src}
        alt={image.alt}
        width={coverWidth}
        height={coverHeight}
        loading="lazy"
      />
    ) : (
      <span aria-hidden="true">{placeholderText}</span>
    )
  }
</span>

<style>
  .favorite-cover {
    aspect-ratio: var(--cover-aspect-ratio);
    display: grid;
    overflow: hidden;
    border: var(--line-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .favorite-cover--track {
    width: 3.75rem;
  }

  .favorite-cover :global(.favorite-cover__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .favorite-cover--placeholder {
    place-items: center;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-accent) 24%, transparent),
        transparent 56%
      ),
      var(--color-surface);
    color: color-mix(in srgb, var(--color-accent) 72%, var(--color-text));
    font-family: var(--font-lora), Georgia, serif;
    font-size: 2rem;
    font-weight: var(--weight-bold);
  }

  .favorite-cover--track.favorite-cover--placeholder {
    font-size: 1.1rem;
  }

  @media (min-width: 641px) {
    .favorite-cover--track {
      width: 4.25rem;
    }
  }
</style>
