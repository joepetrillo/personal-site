---
import type { FavoriteImage } from "../data/favorites/types";
import { Image } from "astro:assets";

interface Props {
  aspectRatio: string;
  image?: FavoriteImage;
  title: string;
}

const { aspectRatio, image, title } = Astro.props;

// Covers render in the `.favorites-grid` (see FavoritesPage.astro): two columns
// on phones, three from 500px, four once the content column caps at its max
// width. Each cell is only ~150-165px wide, so the layout's auto-generated
// `sizes` (which assumes a near-full-width image) would over-fetch. This
// `sizes` mirrors those breakpoints, and the explicit `widths` add the small
// candidates the default constrained breakpoints (≥640px) never produce for
// these short posters.
const COVER_SIZES =
  "(min-width: 728px) 160px, (min-width: 641px) 22vw, (min-width: 500px) 30vw, 45vw";

const placeholderText = title
  .split(/\s+/u)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word.at(0)?.toUpperCase() ?? "")
  .join("");
---

<span
  class:list={["favorite-cover", !image && "favorite-cover--placeholder"]}
  style={`--cover-aspect-ratio: ${aspectRatio}`}
>
  {
    image ? (
      <Image
        class="favorite-cover__image"
        src={image.src}
        alt={image.alt}
        widths={[160, 320, image.src.width]}
        sizes={COVER_SIZES}
        loading="lazy"
      />
    ) : (
      <span aria-hidden="true">{placeholderText}</span>
    )
  }
</span>

<style>
  .favorite-cover {
    aspect-ratio: var(--cover-aspect-ratio);
    display: grid;
    overflow: hidden;
    border: var(--line-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .favorite-cover :global(.favorite-cover__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .favorite-cover--placeholder {
    place-items: center;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-accent) 24%, transparent),
        transparent 56%
      ),
      var(--color-surface);
    color: color-mix(in srgb, var(--color-accent) 72%, var(--color-text));
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: var(--weight-bold);
  }
</style>
