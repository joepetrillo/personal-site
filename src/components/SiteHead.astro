---
import "../styles/global.css";
import { Font, getImage } from "astro:assets";
import avatar from "../assets/avatar.png";
import { SITE } from "../data/site";
import { paletteOverrideCss } from "../data/palettes";
import ThemeScript from "./ThemeScript.astro";

interface Props {
  description: string;
  feedHref?: string;
  feedTitle?: string;
  image?: string;
  imageAlt?: string;
  imageHeight?: number;
  imageType?: string;
  imageWidth?: number;
  publishedTime?: string;
  robots?: string;
  title: string;
  type?: "article" | "website";
}

const {
  description,
  feedHref,
  feedTitle,
  image = SITE.ogImage,
  imageAlt = SITE.ogImageAlt,
  imageHeight = 630,
  imageType = "image/png",
  imageWidth = 1200,
  publishedTime,
  robots,
  title,
  type = "website",
} = Astro.props;
const siteUrl = Astro.site ?? new URL(SITE.url);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const feedUrl = feedHref ? new URL(feedHref, siteUrl) : null;
const paletteCss = paletteOverrideCss();
const favicon = await getImage({
  src: avatar,
  width: 32,
  height: 32,
  format: "png",
  fit: "cover",
});
const appleTouchIcon = await getImage({
  src: avatar,
  width: 180,
  height: 180,
  format: "png",
  fit: "cover",
});
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  description: SITE.description,
  inLanguage: "en-US",
  name: SITE.name,
  publisher: {
    "@type": "Person",
    name: SITE.name,
    sameAs: [SITE.githubUrl, SITE.linkedInUrl],
    url: siteUrl.href,
  },
  url: siteUrl.href,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<ThemeScript />
<style set:html={paletteCss}></style>
<link rel="icon" type="image/png" sizes="32x32" href={favicon.src} />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
{SITE.indexable && <link rel="sitemap" href="/sitemap-index.xml" />}
<link rel="canonical" href={canonicalUrl} />
{
  feedUrl && (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={feedTitle ?? `${SITE.name} RSS`}
      href={feedUrl}
    />
  )
}
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-supreme" preload={[{ style: "normal", weight: 400 }]} />
<Font cssVariable="--font-lora" preload={[{ style: "normal", weight: 600 }]} />
<Font cssVariable="--font-comico" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<meta name="robots" content={robots ?? "index, follow"} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:type" content={imageType} />
{
  type === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
