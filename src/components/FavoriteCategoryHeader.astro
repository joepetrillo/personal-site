---
import PageHeader from "./PageHeader.astro";
import TextLinkList from "./TextLinkList.astro";

const favoriteNavigationItems = [
  { href: "/movies", label: "Movies" },
  { href: "/books", label: "Books" },
  { href: "/quotes", label: "Quotes" },
] as const;

const currentPath = Astro.url.pathname.replace(/\/$/u, "") || "/";
const favoriteNavigationLinks = favoriteNavigationItems.map((item) => ({
  active: currentPath === item.href,
  href: item.href,
  label: item.label,
}));
---

<PageHeader title="Favorites" stacked>
  <nav aria-label="Favorite categories">
    <TextLinkList items={favoriteNavigationLinks} />
  </nav>
</PageHeader>
