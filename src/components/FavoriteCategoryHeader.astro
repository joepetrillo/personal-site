---
const favoriteNavigationItems = [
  { href: "/movies", label: "Movies" },
  { href: "/books", label: "Books" },
  { href: "/quotes", label: "Quotes" },
] as const;

const currentPath = Astro.url.pathname.replace(/\/$/u, "") || "/";
---

<section class="favorites-header" aria-labelledby="favorites-title">
  <h1 id="favorites-title" class="page-title">Favorites</h1>

  <nav class="favorites-nav" aria-label="Favorite categories">
    <ul class="favorites-nav__list">
      {
        favoriteNavigationItems.map((item) => (
          <li>
            <a
              class="nav-link"
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .favorites-header {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .favorites-nav__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1rem;
  }

  @media (min-width: 500px) {
    .favorites-header {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.5rem;
    }

    .favorites-nav__list {
      justify-content: flex-end;
    }
  }
</style>
