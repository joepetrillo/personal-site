---
import { SITE } from "../data/site";
import TextLinkList from "./TextLinkList.astro";
import ThemeControls from "./ThemeControls.astro";

const footerLinks = [
  { href: SITE.githubUrl, label: "GitHub", external: true },
  { href: SITE.linkedInUrl, label: "LinkedIn", external: true },
  { href: SITE.resumeUrl, label: "Resume", external: true },
  { href: SITE.emailHref, label: "Email", external: false },
] as const;

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner site-shell">
    <nav aria-label="Footer links">
      <TextLinkList items={footerLinks} />
    </nav>

    <div class="site-footer__controls">
      <ThemeControls />
    </div>
  </div>

  <p class="site-footer__copyright site-shell">© {currentYear} {SITE.name}</p>
</footer>

<style>
  .site-footer {
    padding-block: 4.5rem 2rem;
  }

  .site-footer__inner {
    display: grid;
    gap: 1rem;
    border-top: var(--line-width) solid var(--color-border);
    padding-top: 1.5rem;
  }

  .site-footer__copyright {
    padding-block-start: 1.5rem;
    color: var(--color-muted);
    font-size: var(--text-meta);
    line-height: var(--leading-ui);
  }

  .site-footer__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 641px) {
    .site-footer__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
