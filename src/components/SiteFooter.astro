---
import { SITE } from "../data/site";

const footerLinks = [
  { href: SITE.githubUrl, label: "GitHub", external: true },
  { href: SITE.linkedInUrl, label: "LinkedIn", external: true },
  { href: SITE.resumeUrl, label: "Resume", external: false },
  { href: SITE.emailHref, label: "Email", external: false },
  { href: "/rss.xml", label: "RSS", external: false },
] as const;

const themeOptions = ["System", "Light", "Dark"] as const;
---

<footer class="site-footer">
  <div class="site-footer__inner site-shell">
    <nav aria-label="Footer links">
      <ul class="site-footer__links inline-links">
        {
          footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                rel={link.external ? "noopener" : undefined}
                target={link.external ? "_blank" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <fieldset class="theme-control">
      <legend class="sr-only">Theme preference</legend>
      {
        themeOptions.map((option) => (
          <button
            class="theme-control__button"
            type="button"
            data-theme-choice={option.toLowerCase()}
            aria-pressed="false"
          >
            {option}
          </button>
        ))
      }
    </fieldset>
  </div>
</footer>

<script is:inline>
  (() => {
    const storageKey = "theme-preference";
    const root = document.documentElement;
    const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
    const buttons = document.querySelectorAll("[data-theme-choice]");

    const getResolvedTheme = (preference) => {
      if (preference === "dark" || preference === "light") {
        return preference;
      }

      return mediaQuery.matches ? "dark" : "light";
    };

    const applyTheme = (preference) => {
      const resolvedTheme = getResolvedTheme(preference);

      root.dataset.theme = resolvedTheme;
      root.dataset.themePreference = preference;

      for (const button of buttons) {
        const isSelected = button.dataset.themeChoice === preference;
        button.setAttribute("aria-pressed", String(isSelected));
      }
    };

    const getSavedPreference = () => {
      const savedPreference = window.localStorage.getItem(storageKey);

      if (savedPreference === "light" || savedPreference === "dark") {
        return savedPreference;
      }

      return "system";
    };

    applyTheme(getSavedPreference());

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const preference = button.dataset.themeChoice ?? "system";

        if (preference === "system") {
          window.localStorage.removeItem(storageKey);
        } else {
          window.localStorage.setItem(storageKey, preference);
        }

        applyTheme(preference);
      });
    }

    mediaQuery.addEventListener("change", () => {
      if ((root.dataset.themePreference ?? "system") === "system") {
        applyTheme("system");
      }
    });
  })();
</script>

<style>
  .site-footer {
    padding-block: 4rem 2.5rem;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 0.0625rem solid var(--color-border);
    padding-top: 1.5rem;
  }

  .theme-control {
    display: flex;
    flex-wrap: wrap;
    min-inline-size: 0;
    gap: 0.4rem 0.8rem;
  }

  .theme-control__button {
    display: inline-flex;
    align-items: center;
    color: var(--color-muted);
    font-size: var(--font-size-small);
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    text-decoration-color: var(--link-underline-active-color);
    text-decoration-line: none;
    text-decoration-thickness: var(--link-underline-thickness);
    text-underline-offset: var(--link-underline-offset);
  }

  .theme-control__button:hover,
  .theme-control__button[aria-pressed="true"] {
    text-decoration-color: var(--link-underline-active-color);
    text-decoration-line: underline;
  }

  .theme-control__button[aria-pressed="true"] {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      display: grid;
      align-items: flex-start;
      grid-template-columns: 1fr;
    }
  }
</style>
