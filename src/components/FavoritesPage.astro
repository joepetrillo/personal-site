---
import type { FavoriteItem } from "../data/favorites/types";
import FavoriteCategoryHeader from "./FavoriteCategoryHeader.astro";
import FavoriteCover from "./FavoriteCover.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
  aspectRatio?: string;
  description: string;
  emptyMessage: string;
  items: FavoriteItem[];
  mediaLabel: string;
  title: string;
}

const {
  aspectRatio = "2 / 3",
  description,
  emptyMessage,
  items,
  mediaLabel,
  title,
} = Astro.props;

const getAriaLabel = (item: FavoriteItem): string =>
  item.year
    ? `${item.title} by ${item.creator}, ${item.year}`
    : `${item.title} by ${item.creator}`;

const getCreatorLabel = (item: FavoriteItem): string =>
  item.year ? `${item.creator}, ${item.year}` : item.creator;
---

<SiteLayout title={title} description={description}>
  <FavoriteCategoryHeader />

  {
    items.length === 0 ? (
      <p class="empty-state">{emptyMessage}</p>
    ) : (
      <ol class="favorites-grid" aria-label={`Favorite ${mediaLabel}`}>
        {items.map((item) => (
          <li>
            {item.url ? (
              <a
                class="favorite-card"
                href={item.url}
                target="_blank"
                rel="noopener"
                aria-label={getAriaLabel(item)}
              >
                <FavoriteCover
                  aspectRatio={aspectRatio}
                  image={item.image}
                  title={item.title}
                />

                <span class="favorite-card__content">
                  <span class="favorite-card__title">{item.title}</span>
                  <span class="favorite-card__creator">
                    {getCreatorLabel(item)}
                  </span>
                </span>
              </a>
            ) : (
              <article class="favorite-card favorite-card--static">
                <FavoriteCover
                  aspectRatio={aspectRatio}
                  image={item.image}
                  title={item.title}
                />

                <span class="favorite-card__content">
                  <span class="favorite-card__title">{item.title}</span>
                  <span class="favorite-card__creator">
                    {getCreatorLabel(item)}
                  </span>
                </span>
              </article>
            )}
          </li>
        ))}
      </ol>
    )
  }
</SiteLayout>

<style>
  .favorites-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  .favorite-card {
    display: grid;
    gap: 0.75rem;
    text-decoration-line: none;
  }

  .favorite-card__content {
    display: grid;
    gap: 0.15rem;
  }

  .favorite-card__title,
  .favorite-card__creator {
    line-height: var(--leading-heading);
  }

  .favorite-card__title {
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
  }

  .favorite-card__creator {
    color: var(--color-muted);
    font-size: var(--text-meta);
  }

  .favorite-card:hover .favorite-card__title {
    text-decoration-color: var(--link-underline-active-color);
    text-decoration-line: underline;
    text-decoration-thickness: var(--link-underline-thickness);
    text-underline-offset: var(--link-underline-offset);
  }

  .favorite-card--static:hover .favorite-card__title {
    text-decoration-line: none;
  }

  @media (min-width: 500px) {
    .favorites-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
  }

  @media (min-width: 641px) {
    .favorites-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
  }
</style>
